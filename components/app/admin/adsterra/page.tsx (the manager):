"use client";

import { useEffect, useState } from "react";
import { createClient } from "@/lib/supabase/client";

const SLOTS = [
  { key: "adsterra_timeline", label: "📣 Timeline — ads between posts" },
  { key: "adsterra_post_comments", label: "💬 Under post comments" },
  { key: "adsterra_video_comments", label: "🎬 Under video comments" },
  { key: "adsterra_reels", label: "🎞️ Reels / Videos page" },
  { key: "adsterra_blog", label: "📰 Blog pages" },
  { key: "adsterra_scanner", label: "🩺 AI Doctor page" },
];

export default function AdsterraManager() {
  const [rows, setRows] = useState<any>({});
  const [loaded, setLoaded] = useState(false);
  const [msg, setMsg] = useState("");

  async function load() {
    const supabase = createClient();
    const { data } = await supabase.from("settings").select("key, value");
    const map: any = {};
    (data || []).forEach((r: any) => {
      try { map[r.key] = JSON.parse(r.value); } catch { map[r.key] = { on: false, code: "" }; }
    });
    setRows(map);
    setLoaded(true);
  }

  useEffect(() => { load(); }, []);

  async function save(key: string, next: any) {
    setRows({ ...rows, [key]: next });
    const supabase = createClient();
    await supabase.from("settings").upsert({ key, value: JSON.stringify(next) });
    setMsg("Saved ✅ — the site obeys this switch immediately.");
    setTimeout(() => setMsg(""), 2500);
  }

  if (!loaded) return <p className="text-center text-gray-500 py-10">Loading…</p>;

  return (
    <div className="p-4 pb-24 max-w-2xl mx-auto">
      <h1 className="text-2xl font-bold mb-1">📢 Adsterra Command Center</h1>
      <p className="text-xs text-gray-500 mb-4">Switch any placement ON or OFF anytime. Paste each unit's script code once. Changes go live instantly.</p>
      {msg && <p className="text-xs font-bold text-green-700 mb-3">{msg}</p>}

      <div className="space-y-4">
        {SLOTS.map((s) => {
          const cfg = rows[s.key] || { on: false, code: "" };
          return (
            <div key={s.key} className="glass-card p-4 rounded-2xl">
              <div className="flex items-center justify-between mb-2">
                <p className="text-sm font-bold">{s.label}</p>
                <button
                  onClick={() => save(s.key, { ...cfg, on: !cfg.on })}
                  className={`px-4 py-1.5 rounded-full text-xs font-extrabold ${cfg.on ? "bg-green-600 text-white" : "bg-gray-300 text-gray-600"}`}
                >
                  {cfg.on ? "ON ✅" : "OFF ⛔"}
                </button>
              </div>
              <textarea
                className="w-full p-2 rounded-xl border border-gray-200 bg-white/70 text-[10px] font-mono"
                rows={3}
                placeholder="Paste this unit's Adsterra script code here..."
                value={cfg.code}
                onChange={(e) => setRows({ ...rows, [s.key]: { ...cfg, code: e.target.value } })}
              />
              <button onClick={() => save(s.key, cfg)} className="mt-1 bg-forest-600 text-white px-4 py-1.5 rounded-xl text-xs font-bold">💾 Save Code</button>
            </div>
          );
        })}
      </div>
    </div>
  );
}