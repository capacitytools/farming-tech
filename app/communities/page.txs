import { createClient } from "@/lib/supabase/server";

export default async function CommunitiesPage() {
  const supabase = createClient();
  const { data: tribes } = await supabase.from("tribes").select("*").order("name");

  return (
    <div className="p-4 pb-24 max-w-4xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">🌾 Farming Communities (Tribes)</h1>
      <div className="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {tribes && tribes.length > 0 ? (
          tribes.map((tribe: any) => (
            <a
              key={tribe.id}
              href={`/communities/${tribe.slug}`}
              className="glass-card p-4 rounded-2xl shadow-lg flex flex-col items-center justify-center text-center hover:scale-105 transition-transform"
            >
              <span className="text-4xl mb-2">{tribe.icon}</span>
              <h2 className="font-bold">{tribe.name}</h2>
              <p className="text-xs text-gray-600 mt-1">{tribe.member_count} members</p>
            </a>
          ))
        ) : (
          <p className="text-gray-500 col-span-full text-center py-10">No tribes found.</p>
        )}
      </div>
    </div>
  );
}
