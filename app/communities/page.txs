import Link from 'next/link';
import { createClient } from '@/lib/supabase/server';

export const revalidate = 300;

export const metadata = {
  title: 'Tribes & Communities',
  description: 'Join farming Tribes for Poultry, Goats, Fish, Rabbits, Pigs, Dogs and Crops.',
};

export default async function CommunitiesPage() {
  const supabase = createClient();
  const { data: tribes } = await supabase
    .from('tribes')
    .select('slug, name, icon, description, member_count')
    .order('member_count', { ascending: false });

  return (
    <div className="px-4 pt-4">
      <h1 className="app-heading mb-1">Tribes & Communities</h1>
      <p className="text-sm text-forest-400 mb-5">
        Join farmers raising the same animals or crops as you.
      </p>

      {!tribes?.length ? (
        <div className="glass-card p-8 text-center">
          <p className="text-forest-500 font-semibold">No tribes found. Check back soon!</p>
        </div>
      ) : (
        <div className="grid grid-cols-2 gap-3">
          {tribes.map((tribe) => (
            <Link
              key={tribe.slug}
              href={`/communities/${tribe.slug}`}
              className="glass-card p-4 flex flex-col items-center text-center gap-2"
            >
              <span className="text-4xl">{tribe.icon}</span>
              <p className="font-bold text-forest-900 dark:text-white">{tribe.name}</p>
              <p className="text-xs text-forest-400 line-clamp-2">{tribe.description}</p>
              <p className="text-xs font-bold text-forest-600 dark:text-gold-400 mt-1">
                {tribe.member_count.toLocaleString()} members
              </p>
            </Link>
          ))}
        </div>
      )}
    </div>
  );
}
