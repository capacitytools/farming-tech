import Image from 'next/image';
import Link from 'next/link';
import { createClient } from '@/lib/supabase/server';
import { formatCurrency } from '@/lib/utils';
import { MapPin } from 'lucide-react';

export const revalidate = 60;

export const metadata = {
  title: 'Marketplace — Buy & Sell Livestock',
  description: 'Browse verified livestock listings from sellers across the platform.',
};

interface Props {
  searchParams: { tribe?: string };
}

export default async function MarketPage({ searchParams }: Props) {
  const supabase = createClient();

  const [{ data: tribes }, listingsQuery] = await Promise.all([
    supabase.from('tribes').select('slug, name, icon'),
    (async () => {
      let query = supabase
        .from('livestock_listings')
        .select('id, title, price, currency, location, images, breed, tribe_id, is_featured, tribes(slug, name, icon)')
        .eq('status', 'active')
        .order('is_featured', { ascending: false })
        .order('created_at', { ascending: false })
        .limit(40);

      if (searchParams.tribe) {
        const { data: tribeRow } = await supabase
          .from('tribes')
          .select('id')
          .eq('slug', searchParams.tribe)
          .single();
        if (tribeRow) query = query.eq('tribe_id', tribeRow.id);
      }

      return query;
    })(),
  ]);

  const { data: listings } = listingsQuery;

  return (
    <div className="px-4 pt-4">
      <h1 className="app-heading mb-1">Marketplace</h1>
      <p className="text-sm text-forest-400 mb-4">Buy livestock directly from verified sellers.</p>

      {/* Tribe filter chips */}
      <div className="flex gap-2 overflow-x-auto no-scrollbar mb-5">
        <Link
          href="/market"
          className={`flex-shrink-0 px-4 py-2 rounded-full text-sm font-bold border-2 ${
            !searchParams.tribe
              ? 'bg-forest-600 border-forest-600 text-white'
              : 'bg-white dark:bg-forest-800 border-forest-100 dark:border-forest-700 text-forest-600 dark:text-forest-300'
          }`}
        >
          All
        </Link>
        {tribes?.map((t) => (
          <Link
            key={t.slug}
            href={`/market?tribe=${t.slug}`}
            className={`flex-shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold border-2 ${
              searchParams.tribe === t.slug
                ? 'bg-forest-600 border-forest-600 text-white'
                : 'bg-white dark:bg-forest-800 border-forest-100 dark:border-forest-700 text-forest-600 dark:text-forest-300'
            }`}
          >
            <span>{t.icon}</span> {t.name}
          </Link>
        ))}
      </div>

      {!listings?.length ? (
        <div className="glass-card p-8 text-center">
          <p className="text-forest-500 font-semibold">
            No listings yet{searchParams.tribe ? ' in this category' : ''}. Check back soon!
          </p>
        </div>
      ) : (
        <div className="grid grid-cols-2 gap-3 pb-6">
          {listings.map((listing: any) => (
            <Link key={listing.id} href={`/market/${listing.id}`} className="glass-card overflow-hidden">
              <div className="relative w-full h-32">
                <Image
                  src={listing.images?.[0] || '/images/placeholder-listing.jpg'}
                  alt={listing.title}
                  fill
                  className="object-cover"
                />
                {listing.is_featured && (
                  <span className="absolute top-2 left-2 bg-gold-500 text-forest-900 text-[10px] font-extrabold px-2 py-0.5 rounded-full">
                    Featured
                  </span>
                )}
              </div>
              <div className="p-3">
                <p className="text-sm font-bold text-forest-900 dark:text-white line-clamp-1">
                  {listing.title}
                </p>
                <p className="text-base font-extrabold text-forest-700 dark:text-gold-400 mt-1">
                  {formatCurrency(listing.price, listing.currency)}
                </p>
                {listing.location && (
                  <p className="flex items-center gap-1 text-[11px] text-forest-400 mt-1">
                    <MapPin className="w-3 h-3" /> {listing.location}
                  </p>
                )}
              </div>
            </Link>
          ))}
        </div>
      )}
    </div>
  );
}
